{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Xopoko/poland/blob/main/schemas/ontology-map.schema.json",
  "title": "Poland derived ontology and coverage map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "data_mode",
    "as_of",
    "projection",
    "summary",
    "layers",
    "relationships",
    "coverage",
    "unmodeled",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "poland.ontology-map.v1"},
    "data_mode": {"const": "OFFLINE_PACKAGED_DATA"},
    "as_of": {"type": "string", "format": "date"},
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "detail"],
      "properties": {
        "layer": {
          "type": ["string", "null"],
          "enum": [
            "services",
            "evidence",
            "channels",
            "vocabulary",
            "geography",
            "safety",
            "ownership",
            "authorities",
            null
          ]
        },
        "detail": {"enum": ["summary", "full"]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layers",
        "relationships",
        "direct_edges",
        "derived_edges",
        "broken_edges",
        "coverage_observations",
        "unmodeled_boundaries"
      ],
      "properties": {
        "layers": {"type": "integer", "minimum": 1},
        "relationships": {"type": "integer", "minimum": 1},
        "direct_edges": {"type": "integer", "minimum": 0},
        "derived_edges": {"type": "integer", "minimum": 0},
        "broken_edges": {"type": "integer", "minimum": 0},
        "coverage_observations": {"type": "integer", "minimum": 0},
        "unmodeled_boundaries": {"type": "integer", "minimum": 0}
      }
    },
    "layers": {
      "type": "array",
      "maxItems": 8,
      "items": {"$ref": "#/$defs/layer"}
    },
    "relationships": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/relationship"}
    },
    "coverage": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/coverage"}
    },
    "unmodeled": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/unmodeled"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity_type", "origin", "record_count", "dimensions"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "entity_type": {"$ref": "#/$defs/identifier"},
        "origin": {"type": "string", "minLength": 1, "maxLength": 160},
        "record_count": {"type": "integer", "minimum": 0},
        "dimensions": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/counts"}
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from_layer",
        "to_layer",
        "kind",
        "field",
        "edge_count",
        "resolved",
        "unresolved"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "from_layer": {"$ref": "#/$defs/slug"},
        "to_layer": {"$ref": "#/$defs/slug"},
        "kind": {"enum": ["direct", "derived"]},
        "field": {"type": "string", "minLength": 1, "maxLength": 120},
        "edge_count": {"type": "integer", "minimum": 0},
        "resolved": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0},
        "derivation": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layer", "classification", "observed", "total"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "layer": {"$ref": "#/$defs/slug"},
        "classification": {"enum": ["linked", "current", "partial", "unlinked", "unmodeled"]},
        "observed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "ids": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    },
    "unmodeled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "observed_values"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "observed_values": {"type": "integer", "minimum": 0}
      }
    }
  }
}
