{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Xopoko/poland/blob/main/schemas/term.schema.json",
  "title": "Poland terminology registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "terms"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "terms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/term"}
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "polish_ascii", "english", "aliases", "source_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "polish_ascii": {"type": "string", "minLength": 1, "maxLength": 240},
        "english": {"type": "string", "minLength": 1, "maxLength": 300},
        "aliases": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/slug"}
        }
      }
    }
  }
}
