{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Xopoko/poland/blob/main/schemas/region.schema.json",
  "title": "Poland voivodeship registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "last_verified", "regions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "last_verified": {"type": "string", "format": "date"},
    "regions": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/region"}
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "administrative_centres"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "administrative_centres": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    }
  }
}
